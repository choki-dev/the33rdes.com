# Cloudflare static headers (the adapter appends immutable caching for /_astro/* at build time).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Hero film and poster are versioned with ?v=, so they can be cached for a year.
/video/*
  Cache-Control: public, max-age=31536000, immutable
