---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logoLight from '../assets/logo-light.png';
import logoDark from '../assets/logo-dark.png';
import { nav, site } from '../data/site';
import { base } from '../lib/urls';

interface Props { overlay?: boolean }
const { overlay = true } = Astro.props;
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));

// Language menu, as on Six Senses: pages are translated by Google Translate, which only loads once a guest picks a language.
const languages = [
  { code: 'en', short: 'EN', name: 'English' },
  { code: 'zh-CN', short: '中文', name: '简体中文' },
  { code: 'ja', short: 'JA', name: '日本語' },
  { code: 'ko', short: 'KO', name: '한국어' },
  { code: 'hi', short: 'HI', name: 'हिन्दी' },
  { code: 'th', short: 'TH', name: 'ไทย' },
  { code: 'de', short: 'DE', name: 'Deutsch' },
  { code: 'fr', short: 'FR', name: 'Français' },
  { code: 'es', short: 'ES', name: 'Español' },
];
---
<header class:list={['site-header', { 'is-solid': !overlay, 'is-home': path === '/' }]} data-header>
  <div class="site-header__inner">
    <div class="site-header__left">
      <div class="lang" translate="no" data-lang>
        <button class="lang__btn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Language: English" data-lang-toggle>
          <svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true"><path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>
          <span data-lang-current>EN</span>
        </button>
        <ul class="lang__list" hidden data-lang-list>
          {languages.map((l) => (
            <li><button type="button" lang={l.code} data-lang-pick={l.code} data-short={l.short}>{l.name}</button></li>
          ))}
        </ul>
      </div>
      <a class="site-header__phone" href={site.phoneHref}>
        <Icon name="phone" size={16} />
        <span>{site.phone}</span>
      </a>
    </div>

    <a class="site-header__logo" href="/" aria-label={`${site.name} — home`}>
      <Image src={logoLight} alt="" class="logo logo--light" width={150} loading="eager" />
      <Image src={logoDark} alt="" class="logo logo--dark" width={150} loading="eager" />
    </a>

    <div class="site-header__right">
      <a class="btn btn--book site-header__book" href="/book"><span>Book now</span></a>
    </div>
  </div>

  <!-- The menu in one line under the logo; it scrolls sideways on narrow screens. -->
  <nav class="site-nav" aria-label="Main">
    <ul>
      {nav.map((item) => (
        <li class="site-nav__item">
          <a href={item.href} class:list={['site-nav__link', { 'is-active': isActive(item.href) || ('children' in item && item.children.some((c) => isActive(c.href))) }]}>{item.label}</a>
          {'children' in item && (
            <ul class="site-nav__sub">
              {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 100;
    color: var(--ivory);
    transition: background .5s var(--ease), color .5s var(--ease), box-shadow .5s var(--ease), transform .5s var(--ease);
  }
  .site-header::before {
    content: ''; position: absolute; inset: 0 0 -40px; z-index: -1; pointer-events: none;
    background: linear-gradient(to bottom, rgba(18, 17, 15, .55), transparent);
    transition: opacity .5s;
  }
  .site-header.is-solid {
    background: rgba(250, 247, 241, .96); color: var(--ink);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--stone);
  }
  .site-header.is-solid::before { opacity: 0; }
  .site-header.is-hidden { transform: translateY(-100%); }

  .site-header__inner {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    height: var(--header-row); padding-inline: var(--gutter);
    max-width: 1680px; margin-inline: auto;
  }
  .site-header__left, .site-header__right { display: flex; align-items: center; gap: 32px; }
  .site-header__right { justify-content: flex-end; }

  /* ---------- Language ---------- */
  .lang { position: relative; }
  .lang__btn {
    display: inline-flex; align-items: center; gap: 8px; padding: 8px 0; min-height: 44px;
    background: none; border: 0; color: inherit; cursor: pointer;
    font-family: var(--font-ui); font-size: .72rem; letter-spacing: .16em; text-transform: uppercase;
  }
  .lang__btn svg { transition: transform .3s var(--ease); }
  .lang__btn[aria-expanded='true'] svg { transform: rotate(180deg); }
  .lang__btn:hover { color: var(--gold-soft); }
  .is-solid .lang__btn:hover { color: var(--gold-deep); }
  .lang__list {
    position: absolute; left: -16px; top: 100%; z-index: 10; min-width: 180px; margin: 6px 0 0; padding: 10px 0; list-style: none;
    background: var(--ink); box-shadow: 0 24px 50px -24px rgba(0, 0, 0, .5);
  }
  .lang__list[hidden] { display: none; }
  .lang__list button {
    display: block; width: 100%; padding: 8px 20px; text-align: left; cursor: pointer;
    background: none; border: 0; color: #cfc8bb; font-family: var(--font-body); font-size: .86rem; letter-spacing: .03em;
    transition: color .3s;
  }
  .lang__list button:hover, .lang__list button[aria-current='true'] { color: var(--gold-soft); }

  .site-header__phone {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-ui); font-size: .72rem; letter-spacing: .16em; text-transform: uppercase;
    opacity: .9; transition: opacity .3s, color .3s;
  }
  .site-header__phone:hover { color: var(--gold-soft); opacity: 1; }
  .is-solid .site-header__phone:hover { color: var(--gold-deep); }

  /* The logo stays inside the top row, clear of the menu line. */
  .site-header__logo { position: relative; display: block; width: 140px; transition: width .5s var(--ease); }
  .logo { width: 100%; height: auto; transition: opacity .4s var(--ease); }
  .logo--dark { position: absolute; inset: 0; opacity: 0; }
  .is-solid .logo--light { opacity: 0; }
  .is-solid .logo--dark { opacity: 1; }
  .is-solid .site-header__logo { width: 104px; }

  .site-header__book { min-height: 44px; padding: 0 24px; white-space: nowrap; }

  @media (max-width: 1080px) {
    .site-header__phone { display: none; }
  }
  @media (max-width: 640px) {
    .site-header__logo { width: 92px; }
    .is-solid .site-header__logo { width: 76px; }
    .site-header__book { min-height: 40px; padding: 0 16px; letter-spacing: .18em; }
  }
  /* Small phones (360px): keep "Book now" on one line beside the logo. */
  @media (max-width: 400px) {
    .site-header__logo { width: 80px; }
    .site-header__book { padding: 0 12px; letter-spacing: .12em; }
  }

  /* ---------- Menu line (same type as the Bhutan Spirit Sanctuary menu: Montserrat, medium) ---------- */
  .site-nav { border-top: 1px solid rgba(250, 247, 241, .2); transition: border-color .5s var(--ease); }
  .is-solid .site-nav { border-top-color: var(--stone); }
  .site-nav > ul {
    list-style: none; margin: 0 auto; padding: 0 var(--gutter); max-width: 1680px; height: var(--nav-h);
    display: flex; align-items: center; gap: clamp(16px, 1.7vw, 36px);
  }
  .site-nav__item { position: relative; }
  .site-nav__link {
    display: block; padding: 10px 0; white-space: nowrap;
    font-family: var(--font-ui); font-size: .7rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase;
    transition: color .3s;
  }
  .site-nav__link:hover, .site-nav__link.is-active { color: var(--gold-soft); }
  .is-solid .site-nav__link:hover, .is-solid .site-nav__link.is-active { color: var(--gold-deep); }
  .site-nav__sub { display: none; }

  /* Wide screens: one centred line, with drop-downs for rooms, dining and spa. */
  @media (min-width: 1280px) {
    .site-nav > ul { justify-content: center; }
    .site-nav__sub {
      display: block; position: absolute; left: 50%; top: 100%; min-width: 220px; margin: 0; padding: 12px 0; list-style: none;
      background: var(--ink); box-shadow: 0 24px 50px -24px rgba(0, 0, 0, .5);
      opacity: 0; visibility: hidden; transform: translate(-50%, 6px);
      transition: opacity .3s var(--ease), transform .3s var(--ease), visibility .3s;
    }
    .site-nav__item:hover .site-nav__sub, .site-nav__item:focus-within .site-nav__sub { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
    .site-nav__sub a {
      display: block; padding: 8px 24px; white-space: nowrap;
      font-family: var(--font-ui); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: #cfc8bb;
      transition: color .3s;
    }
    .site-nav__sub a:hover { color: var(--gold-soft); }
  }
  /* Narrower screens: the line scrolls sideways. */
  @media (max-width: 1279px) {
    .site-nav > ul { overflow-x: auto; scrollbar-width: none; scroll-padding-inline: var(--gutter); }
    .site-nav > ul::-webkit-scrollbar { display: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const overlay = !header.classList.contains('is-solid');
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    if (overlay) header.classList.toggle('is-solid', y > 40);
    // Hide on scroll down, reveal on scroll up.
    header.classList.toggle('is-hidden', y > 400 && y > lastY && !document.body.classList.contains('is-locked'));
    lastY = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // On narrow screens, bring the current page's menu item into view.
  const navList = header.querySelector<HTMLElement>('.site-nav > ul')!;
  const activeItem = navList.querySelector<HTMLElement>('.site-nav__link.is-active')?.parentElement;
  if (activeItem && navList.scrollWidth > navList.clientWidth) {
    navList.scrollLeft = activeItem.offsetLeft - navList.offsetLeft - (navList.clientWidth - activeItem.offsetWidth) / 2;
  }

  // ---------- Language ----------
  // Google Translate reads the chosen language from its "googtrans" cookie (/en/<code>) and translates the page in place.
  const langBox = header.querySelector<HTMLElement>('[data-lang]')!;
  const langBtn = langBox.querySelector<HTMLButtonElement>('[data-lang-toggle]')!;
  const langList = langBox.querySelector<HTMLElement>('[data-lang-list]')!;
  const current = document.cookie.match(/(?:^|;\s*)googtrans=\/en\/([^;]+)/)?.[1] ?? 'en';
  const picks = [...langList.querySelectorAll<HTMLButtonElement>('[data-lang-pick]')];
  const active = picks.find((b) => b.dataset.langPick === current) ?? picks[0];
  active.setAttribute('aria-current', 'true');
  langBox.querySelector('[data-lang-current]')!.textContent = active.dataset.short!;
  langBtn.setAttribute('aria-label', `Language: ${active.textContent}`);

  const setLangOpen = (open: boolean) => {
    langList.hidden = !open;
    langBtn.setAttribute('aria-expanded', String(open));
  };
  langBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    setLangOpen(langBtn.getAttribute('aria-expanded') !== 'true');
  });
  document.addEventListener('click', () => setLangOpen(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setLangOpen(false));
  langList.addEventListener('click', (e) => {
    const code = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-lang-pick]')?.dataset.langPick;
    if (!code || code === current) return setLangOpen(false);
    // Clear any earlier choice (Google may also have stored it for the whole domain), then save the new one.
    const host = location.hostname;
    for (const domain of ['', `; domain=${host}`, `; domain=.${host}`]) document.cookie = `googtrans=; path=/; max-age=0${domain}`;
    if (code !== 'en') document.cookie = `googtrans=/en/${code}; path=/; max-age=31536000`;
    location.reload();
  });

  if (current !== 'en') {
    const holder = document.createElement('div');
    holder.id = 'google_translate_element';
    holder.hidden = true;
    document.body.appendChild(holder);
    (window as any).googleTranslateInit = () =>
      new (window as any).google.translate.TranslateElement({ pageLanguage: 'en', autoDisplay: false }, 'google_translate_element');
    const script = document.createElement('script');
    script.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateInit';
    document.head.appendChild(script);
  }
</script>
