---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logoLight from '../assets/logo-light.png';
import logoDark from '../assets/logo-dark.png';
import { nav, site } from '../data/site';
import { img } from '../lib/images';

interface Props { overlay?: boolean }
const { overlay = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const previews = nav.flatMap((n) => ('image' in n ? [{ href: n.href, image: n.image }] : []));
---
<header class:list={['site-header', { 'is-solid': !overlay, 'is-home': path === '/' }]} data-header>
  <div class="site-header__inner">
    <div class="site-header__left">
      <button class="menu-toggle" type="button" aria-controls="site-drawer" aria-expanded="false" data-menu-open>
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="menu-toggle__label">Menu</span>
      </button>
      <a class="site-header__phone" href={site.phoneHref}>
        <Icon name="phone" size={16} />
        <span>{site.phone}</span>
      </a>
    </div>

    <a class="site-header__logo" href="/" aria-label={`${site.name} — home`}>
      <Image src={logoLight} alt="" class="logo logo--light" width={150} loading="eager" />
      <Image src={logoDark} alt="" class="logo logo--dark" width={150} loading="eager" />
    </a>

    <div class="site-header__right">
      <a class="site-header__link" href="/rooms">Rooms</a>
      <a class="btn site-header__book" href="/book"><span>Book<span class="hide-sm"> your stay</span></span></a>
    </div>
  </div>
</header>

<div class="drawer" id="site-drawer" role="dialog" aria-modal="true" aria-label="Site menu" hidden data-drawer>
  <div class="drawer__backdrop" data-menu-close></div>

  <div class="drawer__previews" aria-hidden="true">
    {previews.map((n, i) => (
      <div class:list={['drawer__preview', { 'is-active': i === 0 }]} data-preview={n.href}>
        <Image src={img(n.image)} alt="" widths={[900, 1400]} sizes="60vw" loading="lazy" />
      </div>
    ))}
    <div class="drawer__preview-caption">
      <span class="eyebrow">Thimphu · Bhutan</span>
      <p>Conscious luxury, rooted in<br /><em>calm</em> and <em>care</em>.</p>
    </div>
  </div>

  <aside class="drawer__panel">
    <div class="drawer__top">
      <button class="drawer__close" type="button" data-menu-close>
        <Icon name="close" size={20} />
        <span>Close</span>
      </button>
      <a class="drawer__book" href="/book">Book now</a>
    </div>

    <nav class="drawer__nav" aria-label="Main">
      <ol>
        {nav.map((item, i) => (
          <li class="drawer__item" style={`--i:${i}`} data-preview-target={'image' in item ? item.href : undefined}>
            <div class="drawer__row">
              <a href={item.href} class:list={['drawer__link', { 'is-active': isActive(item.href) || ('children' in item && item.children.some((c) => isActive(c.href))) }]}>
                {item.label}
              </a>
              {'children' in item && (
                <button class="drawer__expand" type="button" aria-expanded="false" aria-label={`Show ${item.label}`} data-expand>
                  <Icon name="plus" size={18} />
                </button>
              )}
            </div>
            {'children' in item && (
              <div class="drawer__sub"><ul>
                {item.children.map((c) => (
                  <li><a href={c.href} class:list={{ 'is-active': isActive(c.href) }}>{c.label}</a></li>
                ))}
              </ul></div>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <div class="drawer__foot">
      <div>
        <span class="label">Reservations</span>
        <a href={site.phoneHref}>{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div>
        <span class="label">Find us</span>
        <a href={site.mapUrl} target="_blank" rel="noopener">{site.address.street},<br />{site.address.city}, {site.address.country}</a>
      </div>
      <div class="drawer__social">
        <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={18} /></a>
        <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={18} /></a>
        <a href={site.social.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><Icon name="tiktok" size={18} /></a>
        <a href={site.whatsappHref} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" size={18} /></a>
      </div>
    </div>
  </aside>
</div>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 100;
    color: var(--ivory);
    transition: background .5s var(--ease), color .5s var(--ease), box-shadow .5s var(--ease), transform .5s var(--ease);
  }
  .site-header::before {
    content: ''; position: absolute; inset: 0 0 -40px; z-index: -1; pointer-events: none;
    background: linear-gradient(to bottom, rgba(18, 17, 15, .55), transparent);
    transition: opacity .5s;
  }
  .site-header.is-solid {
    background: rgba(250, 247, 241, .96); color: var(--ink);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--stone);
  }
  .site-header.is-solid::before { opacity: 0; }
  .site-header.is-hidden { transform: translateY(-100%); }

  .site-header__inner {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    height: var(--header-h); padding-inline: var(--gutter);
    max-width: 1680px; margin-inline: auto;
  }
  .site-header__left, .site-header__right { display: flex; align-items: center; gap: 32px; }
  .site-header__right { justify-content: flex-end; }

  .menu-toggle {
    display: inline-flex; align-items: center; gap: 16px; padding: 8px 0;
    background: none; border: 0; color: inherit; cursor: pointer;
    font-family: var(--font-ui); font-size: .72rem; letter-spacing: .28em; text-transform: uppercase;
  }
  .menu-toggle__bars { display: grid; gap: 6px; width: 30px; }
  .menu-toggle__bars span { height: 1px; background: currentColor; transition: width .4s var(--ease); }
  .menu-toggle__bars span:nth-child(2) { width: 70%; }
  .menu-toggle__bars span:nth-child(3) { width: 45%; }
  .menu-toggle:hover .menu-toggle__bars span { width: 100%; }

  .site-header__phone, .site-header__link {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-ui); font-size: .72rem; letter-spacing: .16em; text-transform: uppercase;
    opacity: .9; transition: opacity .3s, color .3s;
  }
  .site-header__link { letter-spacing: .28em; }
  .site-header__phone:hover, .site-header__link:hover { color: var(--gold-soft); opacity: 1; }
  .is-solid .site-header__phone:hover, .is-solid .site-header__link:hover { color: var(--gold-deep); }

  .site-header__logo { position: relative; display: block; width: 136px; margin-top: 18px; transition: width .5s var(--ease), margin .5s var(--ease); }
  .logo { width: 100%; height: auto; transition: opacity .4s var(--ease); }
  .logo--dark { position: absolute; inset: 0; opacity: 0; }
  .is-solid .logo--light { opacity: 0; }
  .is-solid .logo--dark { opacity: 1; }
  .is-solid .site-header__logo { width: 84px; margin-top: 0; }

  .site-header__book { min-height: 44px; padding: 0 24px; --btn-bg: transparent; --btn-fg: var(--ivory); --btn-bd: var(--gold); }
  .site-header__book::before { background: var(--gold); }
  .site-header__book:hover { border-color: var(--gold); }
  .is-solid .site-header__book { --btn-bg: var(--gold); --btn-fg: var(--white); }
  .is-solid .site-header__book::before { background: var(--ink); }
  .is-solid .site-header__book:hover { border-color: var(--ink); }
  /* On the home page the hero carries the large logo, so the header mark waits until scroll. */
  .is-home:not(.is-solid) .site-header__logo { opacity: 0; pointer-events: none; }

  @media (max-width: 1080px) {
    .site-header__phone, .site-header__link { display: none; }
  }
  @media (max-width: 640px) {
    :global(:root) { --header-h: 72px; }
    .menu-toggle__label, .hide-sm { display: none; }
    .site-header__logo { width: 84px; }
    .is-solid .site-header__logo { width: 64px; }
    .site-header__book { min-height: 40px; padding: 0 16px; letter-spacing: .18em; }
  }

  /* ---------- Drawer ---------- */
  .drawer { position: fixed; inset: 0; z-index: 200; }
  .drawer[hidden] { display: none; }
  .drawer__backdrop {
    position: absolute; inset: 0; background: rgba(18, 17, 15, .55);
    opacity: 0; transition: opacity .6s var(--ease);
  }
  .drawer.is-open .drawer__backdrop { opacity: 1; }

  .drawer__panel {
    position: absolute; inset: 0 auto 0 0; width: min(560px, 100%);
    display: flex; flex-direction: column;
    background: var(--ink); color: #cfc8bb;
    padding: 28px clamp(28px, 5vw, 64px) 36px;
    overflow-y: auto; overscroll-behavior: contain;
    transform: translateX(-100%); transition: transform .8s var(--ease-out);
  }
  .drawer.is-open .drawer__panel { transform: none; }
  .drawer__panel::after {
    content: ''; position: absolute; top: 0; right: 0; bottom: 0; width: 1px;
    background: linear-gradient(to bottom, transparent, var(--gold), transparent); opacity: .5;
  }

  .drawer__top { display: flex; justify-content: space-between; align-items: center; min-height: 44px; margin-bottom: clamp(28px, 6vh, 64px); }
  .drawer__close {
    display: inline-flex; align-items: center; gap: 14px; padding: 8px 0;
    background: none; border: 0; color: var(--ivory); cursor: pointer;
    font-family: var(--font-ui); font-size: .72rem; letter-spacing: .28em; text-transform: uppercase;
  }
  .drawer__close :global(svg) { transition: transform .5s var(--ease); }
  .drawer__close:hover :global(svg) { transform: rotate(90deg); }
  .drawer__book {
    font-family: var(--font-ui); font-size: .7rem; letter-spacing: .28em; text-transform: uppercase;
    color: var(--gold-soft); border-bottom: 1px solid var(--gold); padding-bottom: 4px;
  }

  .drawer__nav ol { list-style: none; margin: 0; padding: 0; }
  .drawer__item {
    border-bottom: 1px solid rgba(216, 199, 156, .12);
    opacity: 0; transform: translateX(-24px);
    transition: opacity .7s var(--ease-out), transform .7s var(--ease-out);
    transition-delay: calc(.18s + var(--i) * .05s);
  }
  .drawer.is-open .drawer__item { opacity: 1; transform: none; }
  .drawer__row { display: flex; align-items: center; justify-content: space-between; }
  .drawer__link {
    display: flex; align-items: baseline; gap: 18px; padding: clamp(8px, 1.4vh, 14px) 0; flex: 1;
    font-family: var(--font-display); font-size: clamp(1.35rem, min(3vw, 3.6vh), 1.85rem); line-height: 1.15; color: var(--ivory);
    transition: color .3s, transform .5s var(--ease);
  }
  .drawer__link:hover, .drawer__link.is-active { color: var(--gold-soft); }
  .drawer__link:hover { transform: translateX(8px); }
  .drawer__expand {
    width: 44px; height: 44px; display: grid; place-items: center;
    background: none; border: 1px solid rgba(216, 199, 156, .25); border-radius: 50%; color: var(--gold-soft); cursor: pointer;
    transition: transform .5s var(--ease), border-color .3s;
  }
  .drawer__expand:hover { border-color: var(--gold); }
  .drawer__expand[aria-expanded='true'] { transform: rotate(45deg); }
  .drawer__sub {
    display: grid; grid-template-rows: 0fr; padding-left: 40px;
    transition: grid-template-rows .5s var(--ease), padding .5s var(--ease);
  }
  .drawer__sub ul { list-style: none; margin: 0; padding: 0; min-height: 0; overflow: hidden; visibility: hidden; transition: visibility .5s; }
  .drawer__item.is-expanded .drawer__sub ul { visibility: visible; }
  .drawer__item.is-expanded .drawer__sub { grid-template-rows: 1fr; padding-bottom: 16px; }
  .drawer__sub a {
    display: block; padding: 6px 0;
    font-family: var(--font-ui); font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: #a9a294;
    transition: color .3s, padding .4s var(--ease);
  }
  .drawer__sub a:hover, .drawer__sub a.is-active { color: var(--gold-soft); padding-left: 6px; }

  .drawer__foot {
    margin-top: auto; padding-top: 40px;
    display: grid; grid-template-columns: auto 1fr; gap: 24px 32px; font-size: .9rem; line-height: 1.6;
  }
  .drawer__foot .label { display: block; margin-bottom: 8px; color: var(--gold); }
  .drawer__foot a { display: block; color: #cfc8bb; transition: color .3s; overflow-wrap: anywhere; }
  .drawer__foot > div:first-child a { white-space: nowrap; }
  .drawer__foot a:hover { color: var(--ivory); }
  .drawer__social { grid-column: 1 / -1; display: flex; gap: 10px; }
  .drawer__social a {
    width: 40px; height: 40px; display: grid; place-items: center;
    border: 1px solid rgba(216, 199, 156, .25); border-radius: 50%; color: var(--gold-soft);
  }
  .drawer__social a:hover { border-color: var(--gold); background: var(--gold); color: var(--ink); }

  .drawer__previews {
    position: absolute; inset: 0 0 0 min(560px, 100%); overflow: hidden;
    opacity: 0; transition: opacity .8s var(--ease) .1s;
  }
  .drawer.is-open .drawer__previews { opacity: 1; }
  .drawer__preview { position: absolute; inset: 0; opacity: 0; transition: opacity 1s var(--ease); }
  .drawer__preview.is-active { opacity: 1; }
  .drawer__preview :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); transition: transform 6s linear; }
  .drawer__preview.is-active :global(img) { transform: scale(1); }
  .drawer__previews::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(18, 17, 15, .7), rgba(18, 17, 15, .1) 55%); }
  .drawer__preview-caption { position: absolute; left: clamp(32px, 5vw, 72px); bottom: clamp(32px, 6vw, 72px); z-index: 1; color: var(--ivory); }
  .drawer__preview-caption .eyebrow { color: var(--gold-soft); }
  .drawer__preview-caption p { font-family: var(--font-display); font-size: clamp(1.6rem, 2.6vw, 2.4rem); line-height: 1.15; margin: 0; }
  .drawer__preview-caption em { color: var(--gold-soft); }
  @media (max-width: 900px) { .drawer__previews { display: none; } }
  @media (max-width: 480px) { .drawer__foot { grid-template-columns: 1fr; } }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const overlay = !header.classList.contains('is-solid');
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    if (overlay) header.classList.toggle('is-solid', y > 40);
    // Hide on scroll down, reveal on scroll up.
    header.classList.toggle('is-hidden', y > 400 && y > lastY && !document.body.classList.contains('is-locked'));
    lastY = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const drawer = document.querySelector<HTMLElement>('[data-drawer]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  let closeTimer: number | undefined;

  const open = () => {
    clearTimeout(closeTimer);
    drawer.hidden = false;
    requestAnimationFrame(() => requestAnimationFrame(() => drawer.classList.add('is-open')));
    document.body.classList.add('is-locked');
    openBtn.setAttribute('aria-expanded', 'true');
    drawer.querySelector<HTMLElement>('.drawer__close')?.focus();
  };
  const close = () => {
    drawer.classList.remove('is-open');
    document.body.classList.remove('is-locked');
    openBtn.setAttribute('aria-expanded', 'false');
    closeTimer = window.setTimeout(() => (drawer.hidden = true), 700);
    openBtn.focus();
  };

  openBtn.addEventListener('click', open);
  drawer.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', close));
  document.addEventListener('keydown', (e) => {
    if (drawer.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'Tab') {
      const focusables = [...drawer.querySelectorAll<HTMLElement>('a, button')].filter((el) => el.offsetParent !== null);
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  drawer.querySelectorAll<HTMLButtonElement>('[data-expand]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.drawer__item')!;
      const expanded = item.classList.toggle('is-expanded');
      btn.setAttribute('aria-expanded', String(expanded));
    });
  });

  const previews = drawer.querySelectorAll<HTMLElement>('[data-preview]');
  drawer.querySelectorAll<HTMLElement>('[data-preview-target]').forEach((item) => {
    item.addEventListener('mouseenter', () => {
      previews.forEach((p) => p.classList.toggle('is-active', p.dataset.preview === item.dataset.previewTarget));
    });
  });
</script>
