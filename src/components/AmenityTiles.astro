---
import { roomAmenities } from '../data/site';

interface Props {
  /** Full-width layout (Rooms page): roomier tiles in a centred block. */
  wide?: boolean;
}
const { wide = false } = Astro.props;

// Line icons for the amenity tiles (24px grid, drawn with the current colour); unknown items get a tick.
const amenityIcons: Record<string, string> = {
  'Mini kitchen & microwave': '<rect x="3" y="6" width="18" height="12" rx="1"/><rect x="5.5" y="8.5" width="9" height="7"/><path d="M17.5 9.5v.01M17.5 12v.01M17.5 14.5v.01"/>',
  'Bathtub & rain shower': '<path d="M3 12h18v2a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5v-2Z"/><path d="M6 12V6a2 2 0 0 1 4 0"/><path d="M7 19l-1 2M17 19l1 2"/>',
  'Air conditioning': '<path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"/><path d="M9.5 4.5 12 7l2.5-2.5M9.5 19.5 12 17l2.5 2.5"/>',
  'Smart TV with satellite channels': '<rect x="3" y="5" width="18" height="12" rx="1"/><path d="M8 21h8M12 17v4"/>',
  'High-speed in-room Wi-Fi': '<path d="M2.5 9a14 14 0 0 1 19 0M5.5 12.5a9.5 9.5 0 0 1 13 0M8.5 16a5 5 0 0 1 7 0"/><circle cx="12" cy="19" r=".9"/>',
  'Minibar & fridge': '<rect x="6" y="3" width="12" height="18" rx="1"/><path d="M6 10h12M9 6v2M9 13v3"/>',
  'Tea & coffee making facilities': '<path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9Z"/><path d="M17 11h1.5a2.5 2.5 0 0 1 0 5H17"/><path d="M8 3c0 1.5 1.5 1.5 1.5 3M12 3c0 1.5 1.5 1.5 1.5 3"/>',
  'Bathrobes & slippers': '<path d="M8 3h8l4 4-3 2v12H7V9L4 7l4-4Z"/><path d="M8 3l4 7 4-7M7 14h10"/>',
  'Premium toiletries & hairdryer': '<path d="M9.5 3h5v3h-5z"/><path d="M8 6h8l1 3v10a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V9l1-3Z"/><path d="M7 12h10"/>',
  'In-room safe': '<rect x="3" y="4" width="18" height="15" rx="1"/><circle cx="12" cy="11.5" r="3.5"/><path d="M12 8v1M12 14v1M8.5 11.5h1M14.5 11.5h1M6 19v2M18 19v2"/>',
  'Study desk & telephone': '<path d="M3 11h18M5 11v9M19 11v9M14 11v5h5"/><path d="M7 8a2 2 0 0 1 4 0v3H7Z"/>',
  'Complimentary refilled water': '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/><path d="M9 14.5a3 3 0 0 0 3 3"/>',
  '24-hour room service': '<path d="M3 17h18M5 17a7 7 0 0 1 14 0"/><path d="M12 10V8M10 8h4M2 20h20"/>',
  'Laundry service': '<path d="M12 7.5a2 2 0 1 1 2-2"/><path d="M12 7.5v1L3 15.5h18l-9-7"/>',
  'Wake-up call service': '<circle cx="12" cy="13" r="7"/><path d="M12 9.5V13l2.5 2M4 5.5 7 3M20 5.5 17 3"/>',
};
const tick = '<path d="M5 12.5 10 17 19 7"/>';
---
<ul class:list={['amen', { 'amen--wide': wide }]}>
  {roomAmenities.map((a, i) => (
    <li class:list={['reveal', `reveal-delay-${i % 3}`]}>
      <span class="amen__icon">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" set:html={amenityIcons[a] ?? tick} />
      </span>
      <span class="amen__label">{a}</span>
    </li>
  ))}
</ul>

<style>
  /* Icon tiles; a tile turns dark on hover. */
  .amen { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .amen li {
    display: flex; align-items: center; gap: 10px; padding: 10px 12px;
    background: var(--white); border: 1px solid transparent; font-size: .76rem; line-height: 1.3; color: var(--charcoal);
    transition: background .4s var(--ease), color .4s, transform .4s var(--ease), border-color .4s;
  }
  .amen__icon {
    flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%;
    border: 1px solid var(--gold-soft); color: var(--gold-deep); transition: background .4s, color .4s, border-color .4s;
  }
  .amen__label { min-width: 0; overflow-wrap: break-word; }
  .amen li:hover { background: var(--ink); color: var(--ivory); transform: translateY(-2px); }
  .amen li:hover .amen__icon { background: var(--gold); border-color: var(--gold); color: var(--ink); }

  .amen--wide { max-width: 1040px; margin-inline: auto; gap: 8px; }
  .amen--wide li { padding: 14px 16px; gap: 14px; font-size: .8rem; }
  .amen--wide .amen__icon { width: 38px; height: 38px; }

  /* Beside the booking card on the room page the column is narrow. */
  @media (max-width: 1200px) and (min-width: 1001px) { .amen:not(.amen--wide) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .amen, .amen--wide { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .amen li { padding: 10px; gap: 10px; }
    .amen--wide .amen__icon { width: 32px; height: 32px; }
  }
  @media (max-width: 380px) { .amen, .amen--wide { grid-template-columns: minmax(0, 1fr); } }
</style>
