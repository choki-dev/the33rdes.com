---
// Floating WhatsApp button on the side of every page (Chaty-style), with a small greeting bubble.
import { site } from '../data/site';

const message = 'Hello, I have a question about The 33rd Executive Suites.';
const href = `${site.whatsappHref}?text=${encodeURIComponent(message)}`;
---
<div class="wa" data-wa-float>
  <div class="wa__bubble" data-wa-bubble hidden>
    <button type="button" class="wa__close" aria-label="Close message" data-wa-close>&times;</button>
    <strong>Need help?</strong>
    <span>Chat with our reservations team on WhatsApp.</span>
  </div>
  <a class="wa__btn" href={href} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.27-.2-.57-.35M12.05 21.79h-.01a9.87 9.87 0 01-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 01-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 012.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.29A11.82 11.82 0 0012.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 005.69 1.45c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 00-3.48-8.41z"/></svg>
    <span class="wa__label">Chat with us</span>
  </a>
</div>

<style>
  .wa {
    position: fixed; right: clamp(16px, 2.4vw, 28px); bottom: clamp(16px, 2.4vw, 28px); z-index: 95; display: flex; flex-direction: column; align-items: flex-end; gap: 12px;
    transition: opacity .4s var(--ease), transform .4s var(--ease), visibility 0s;
  }
  /* Steps aside while a [data-wa-avoid] element (the hero booking bar) is on screen, so it never covers it. */
  .wa--away { opacity: 0; visibility: hidden; transform: translateY(16px); pointer-events: none; transition: opacity .4s var(--ease), transform .4s var(--ease), visibility 0s .4s; }

  .wa__btn {
    position: relative; display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%;
    background: #25d366; color: var(--white); box-shadow: 0 12px 28px -8px rgba(18, 140, 70, .55);
    transition: transform .3s var(--ease), box-shadow .3s var(--ease);
  }
  .wa__btn:hover { transform: scale(1.06); box-shadow: 0 16px 34px -8px rgba(18, 140, 70, .65); }
  /* Soft pulse ring to draw the eye, as on Chaty. */
  .wa__btn::before {
    content: ''; position: absolute; inset: 0; border-radius: 50%; background: #25d366; z-index: -1;
    animation: wa-pulse 2.6s var(--ease) infinite;
  }
  .wa__label {
    position: absolute; right: calc(100% + 14px); top: 50%; translate: 0 -50%; white-space: nowrap; pointer-events: none;
    padding: 8px 14px; background: var(--ink); color: var(--ivory); border-radius: 4px;
    font-family: var(--font-ui); font-size: .66rem; letter-spacing: .14em; text-transform: uppercase;
    opacity: 0; transform: translateX(6px); transition: opacity .3s, transform .3s;
  }
  .wa__btn:hover .wa__label, .wa__btn:focus-visible .wa__label { opacity: 1; transform: none; }

  .wa__bubble {
    position: relative; width: 250px; padding: 16px 34px 16px 18px; background: var(--white); color: var(--charcoal);
    border-radius: 10px 10px 2px 10px; box-shadow: 0 18px 40px -16px rgba(29, 28, 26, .35);
    font-size: .8rem; line-height: 1.5; animation: wa-in .5s var(--ease-out) both;
  }
  .wa__bubble[hidden] { display: none; }
  .wa__bubble strong { display: block; font-family: var(--font-display); font-weight: 400; font-size: 1.1rem; color: var(--ink); }
  .wa__close {
    position: absolute; top: 6px; right: 8px; width: 24px; height: 24px; padding: 0; border: 0; background: none; cursor: pointer;
    font-size: 1.2rem; line-height: 1; color: var(--muted);
  }
  .wa__close:hover { color: var(--ink); }

  @keyframes wa-pulse { 0% { transform: scale(1); opacity: .5; } 70%, 100% { transform: scale(1.6); opacity: 0; } }
  @keyframes wa-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  /* Phones: the bottom quick-action bar already has a WhatsApp button, so the floating one steps aside. */
  @media (max-width: 600px) {
    .wa { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa__btn::before { animation: none; opacity: 0; }
  }
</style>

<script>
  // Step aside while anything marked [data-wa-avoid] is in view.
  const float = document.querySelector<HTMLElement>('[data-wa-float]');
  const avoid = [...document.querySelectorAll<HTMLElement>('[data-wa-avoid]')];
  const inView = new Set<Element>();
  const onAway = new Set<() => void>();
  const isAway = () => inView.size > 0;
  if (float && avoid.length) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? inView.add(e.target) : inView.delete(e.target);
      float.classList.toggle('wa--away', isAway());
      if (!isAway()) onAway.forEach((fn) => fn());
    });
    avoid.forEach((el) => io.observe(el));
  }

  // Show the greeting bubble once per visit, a few seconds after the page opens (or once the float is back in view).
  const bubble = document.querySelector<HTMLElement>('[data-wa-bubble]');
  if (bubble) {
    const KEY = 'wa-bubble-dismissed';
    let dismissed = false;
    try { dismissed = sessionStorage.getItem(KEY) === '1'; } catch {}
    const dismiss = () => {
      bubble.hidden = true;
      try { sessionStorage.setItem(KEY, '1'); } catch {}
    };
    if (!dismissed) setTimeout(() => (bubble.hidden = false), 4000);
    // While the float is hidden the bubble waits, then plays its entrance when the float returns.
    onAway.add(() => bubble.hidden || bubble.getAnimations().forEach((a) => (a.cancel(), a.play())));
    bubble.querySelector('[data-wa-close]')?.addEventListener('click', dismiss);
    document.querySelector('[data-wa-float] .wa__btn')?.addEventListener('click', dismiss);
  }
</script>
