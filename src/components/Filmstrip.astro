---
// Photo filmstrip: a staggered, draggable row of photos at their natural shape, a gold progress bar and
// arrows; each photo opens in the page's <Lightbox />. Used by room, experience and gallery pages.
import { Image, getImage } from 'astro:assets';
import { img } from '../lib/images';

interface Props {
  images: string[];
  caption: string;
  eyebrow?: string;
  /** Heading HTML, e.g. 'Inside the <em>Valley</em>'. */
  title: string;
  id?: string;
  tone?: 'sand' | 'white';
}
const { images, caption, eyebrow = 'Gallery', title, id, tone = 'sand' } = Astro.props;
const large = await Promise.all(images.map((key) => getImage({ src: img(key), width: 1800, format: 'webp' })));
---
<section class:list={['section fs', { 'section--sand': tone === 'sand' }]} id={id} data-xg>
  <div class="container fs__head reveal">
    <span class="eyebrow">{eyebrow}</span>
    <h2 set:html={title} />
  </div>
  <div class="fs__strip" data-xg-strip>
    {images.map((key, i) => (
      <a href={large[i].src} data-lightbox data-caption={caption} class:list={['fs__item', { 'fs__item--low': i % 2 === 1 }]}>
        <Image src={img(key)} alt={`${caption} — photo ${i + 1}`} widths={[320, 480, 700, 1000]} sizes="(max-width: 700px) 70vw, 40vw" />
        <span class="fs__num">{String(i + 1).padStart(2, '0')}</span>
      </a>
    ))}
  </div>
  <div class="container fs__controls">
    <div class="fs__progress" aria-hidden="true"><span data-xg-bar></span></div>
    <div class="fs__nav">
      <button type="button" class="fs__arrow" data-xg-step="-1" aria-label="Scroll photos left">&#8592;</button>
      <button type="button" class="fs__arrow" data-xg-step="1" aria-label="Scroll photos right">&#8594;</button>
    </div>
  </div>
</section>

<style>
  .fs { overflow: hidden; scroll-margin-top: var(--header-h); }
  .fs__head { margin-bottom: 40px; }
  .fs__head h2 { margin: 0; }
  .fs__strip {
    --edge: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    display: flex; align-items: flex-start; gap: clamp(14px, 2vw, 24px);
    overflow-x: auto; scrollbar-width: none; padding: 0 var(--edge) 48px; cursor: grab;
  }
  .fs__strip::-webkit-scrollbar { display: none; }
  .fs__strip.is-dragging { cursor: grabbing; }
  .fs__strip.is-dragging .fs__item { pointer-events: none; }
  .fs__item { position: relative; flex: none; display: block; overflow: hidden; background: var(--stone); cursor: zoom-in; }
  .fs__item--low { margin-top: 48px; }
  .fs__item :global(img) {
    display: block; height: clamp(260px, 34vw, 480px); width: auto; max-width: none;
    transition: transform 1.2s var(--ease-out);
    -webkit-user-drag: none; user-select: none;
  }
  .fs__item:hover :global(img) { transform: scale(1.04); }
  .fs__num {
    position: absolute; left: 14px; bottom: 12px; font-family: var(--font-display); font-size: 1rem; color: var(--ivory);
    text-shadow: 0 2px 10px rgba(0, 0, 0, .5); opacity: 0; transform: translateY(6px); transition: opacity .4s, transform .4s;
  }
  .fs__item:hover .fs__num { opacity: 1; transform: none; }
  .fs__controls { display: flex; align-items: center; gap: 32px; }
  .fs__progress { flex: 1; height: 1px; background: var(--stone); position: relative; }
  .fs__progress span { position: absolute; left: 0; top: -1px; height: 3px; width: 20%; background: var(--gold); transition: left .3s var(--ease), width .3s var(--ease); }
  .fs__nav { display: flex; gap: 8px; }
  .fs__arrow {
    width: 50px; height: 50px; border-radius: 50%; border: 1px solid var(--ink); background: none; cursor: pointer; color: var(--ink);
    transition: background .3s, color .3s;
  }
  .fs__arrow:hover { background: var(--ink); color: var(--ivory); }
  @media (max-width: 700px) {
    .fs__arrow { width: 42px; height: 42px; }
    .fs__item--low { margin-top: 28px; }
  }
</style>

<script>
  // Drag with the mouse, arrows step by most of a screen, the gold bar follows the scroll.
  document.querySelectorAll<HTMLElement>('[data-xg]').forEach((root) => {
    const strip = root.querySelector<HTMLElement>('[data-xg-strip]')!;
    const bar = root.querySelector<HTMLElement>('[data-xg-bar]')!;
    const sync = () => {
      const max = strip.scrollWidth - strip.clientWidth;
      const visible = strip.clientWidth / strip.scrollWidth;
      bar.style.width = `${visible * 100}%`;
      bar.style.left = `${max > 0 ? (strip.scrollLeft / max) * (1 - visible) * 100 : 0}%`;
    };
    strip.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    addEventListener('load', sync);
    sync();
    root.querySelectorAll<HTMLButtonElement>('[data-xg-step]').forEach((b) =>
      b.addEventListener('click', () => strip.scrollBy({ left: Number(b.dataset.xgStep) * strip.clientWidth * 0.7, behavior: 'smooth' })),
    );

    // Mouse drag; a drag of more than a few pixels does not count as a click on a photo.
    let down = false;
    let moved = false;
    let startX = 0;
    let startLeft = 0;
    strip.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      down = true;
      moved = false;
      startX = e.clientX;
      startLeft = strip.scrollLeft;
    });
    addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 5) {
        moved = true;
        strip.classList.add('is-dragging');
      }
      strip.scrollLeft = startLeft - dx;
    });
    addEventListener('pointerup', () => {
      down = false;
      strip.classList.remove('is-dragging');
    });
    strip.addEventListener('click', (e) => {
      if (moved) {
        e.preventDefault();
        e.stopImmediatePropagation();
        moved = false;
      }
    }, true);
  });
</script>
