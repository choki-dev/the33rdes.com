---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<div class="mbar" aria-label="Quick actions">
  <a href={site.phoneHref}><Icon name="phone" size={18} /><span>Call</span></a>
  <a href={site.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /><span>WhatsApp</span></a>
  <a class="mbar__book" href="/book">Book now</a>
</div>

<style>
  .mbar { display: none; }
  @media (max-width: 600px) {
    .mbar {
      position: fixed; inset: auto 0 0; z-index: 90; display: grid; grid-template-columns: 1fr 1fr 2fr;
      background: var(--ink); border-top: 1px solid rgba(216, 199, 156, .2);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .mbar a {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; min-height: var(--mbar-h);
      color: var(--gold-soft); font-family: var(--font-ui); font-size: .6rem; letter-spacing: .16em; text-transform: uppercase;
    }
    .mbar .mbar__book { background: var(--gold); color: var(--white); font-size: .7rem; letter-spacing: .22em; transition: background .3s, color .3s; }
    .mbar .mbar__book:hover { background: var(--white); color: var(--gold-deep); }
  }
</style>
