<script>
  // Discover Thimphu slideshow: arrows, gentle autoplay (paused on hover/focus and for reduced motion).
  const slides = document.querySelector<HTMLElement>('[data-slides]');
  if (slides) {
    const items = [...slides.querySelectorAll<HTMLElement>('[data-slide]')];
    const current = slides.querySelector('[data-slides-current]');
    let index = 0;
    const go = (n: number) => {
      index = (n + items.length) % items.length;
      items.forEach((el, i) => {
        const on = i === index;
        el.classList.toggle('is-active', on);
        if (on) {
          el.removeAttribute('aria-hidden');
          el.removeAttribute('tabindex');
        } else {
          el.setAttribute('aria-hidden', 'true');
          el.tabIndex = -1;
        }
      });
      if (current) current.textContent = String(index + 1).padStart(2, '0');
    };
    slides.querySelectorAll<HTMLButtonElement>('[data-slides-step]').forEach((b) =>
      b.addEventListener('click', () => go(index + Number(b.dataset.slidesStep))),
    );
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let paused = false;
      ['mouseenter', 'focusin'].forEach((e) => slides.addEventListener(e, () => (paused = true)));
      ['mouseleave', 'focusout'].forEach((e) => slides.addEventListener(e, () => (paused = false)));
      setInterval(() => !paused && !document.hidden && go(index + 1), 6000);
    }
  }
</script>

<script>
  // Hero slideshow: crossfade every 6s while the hero is on screen; the round button pauses it.
  // Reduced-motion visitors get the first photo only.
  const hero = document.querySelector<HTMLElement>('.hero');
  const slides = [...document.querySelectorAll<HTMLElement>('[data-hero-slides] .hero__slide')];
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  if (hero && toggle && slides.length > 1) {
    const pauseIcon = toggle.innerHTML;
    const playIcon = '<svg width="14" height="14" viewBox="0 0 22 22" aria-hidden="true"><path d="M7 4.5v13l11-6.5z" fill="currentColor"/></svg>';
    let current = 0;
    let paused = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let onScreen = true;
    const show = (next: number) => {
      slides[current].classList.remove('is-active');
      slides[current].setAttribute('aria-hidden', 'true');
      current = (next + slides.length) % slides.length;
      slides[current].classList.add('is-active');
      slides[current].removeAttribute('aria-hidden');
    };
    const sync = () => {
      hero.classList.toggle('is-paused', paused);
      toggle.innerHTML = paused ? playIcon : pauseIcon;
      toggle.setAttribute('aria-label', paused ? 'Play slideshow' : 'Pause slideshow');
    };
    new IntersectionObserver(([e]) => (onScreen = e.isIntersecting)).observe(hero);
    setInterval(() => !paused && onScreen && !document.hidden && show(current + 1), 6000);
    toggle.addEventListener('click', () => {
      paused = !paused;
      sync();
    });
    sync();
  }

  // Rooms carousel: arrows step one room; the gold bar mirrors scroll position; auto-slides while on screen.
  const suites = document.querySelector<HTMLElement>('[data-suites]');
  const suitesBar = document.querySelector<HTMLElement>('[data-suites-bar]');
  if (suites && suitesBar) {
    const step = () => (suites.querySelector<HTMLElement>('.suite')?.offsetWidth ?? 600) + 32;
    document.querySelectorAll<HTMLButtonElement>('[data-suites-step]').forEach((btn) =>
      btn.addEventListener('click', () => suites.scrollBy({ left: Number(btn.dataset.suitesStep) * step(), behavior: 'smooth' })),
    );
    const sync = () => {
      const max = suites.scrollWidth - suites.clientWidth;
      const visible = suites.clientWidth / suites.scrollWidth;
      suitesBar.style.width = `${visible * 100}%`;
      suitesBar.style.left = `${max > 0 ? (suites.scrollLeft / max) * (1 - visible) * 100 : 0}%`;
    };
    suites.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    sync();

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let visible = false;
      let paused = false;
      ['mouseenter', 'focusin', 'touchstart'].forEach((e) => suites.addEventListener(e, () => (paused = true), { passive: true }));
      ['mouseleave', 'focusout', 'touchend'].forEach((e) => suites.addEventListener(e, () => (paused = false), { passive: true }));
      new IntersectionObserver(([entry]) => (visible = entry.isIntersecting), { threshold: 0.3 }).observe(suites);
      setInterval(() => {
        if (!visible || paused || document.hidden) return;
        // At the last room, glide back to the first.
        const atEnd = suites.scrollLeft >= suites.scrollWidth - suites.clientWidth - 8;
        suites.scrollTo({ left: atEnd ? 0 : suites.scrollLeft + step(), behavior: 'smooth' });
      }, 5000);
    }
  }

  // Experiences showcase: one item open at a time, image crossfades to match.
  const lux = document.querySelector<HTMLElement>('[data-lux]');
  if (lux) {
    const items = [...lux.querySelectorAll<HTMLElement>('[data-item]')];
    const slides = [...lux.querySelectorAll<HTMLElement>('[data-slide]')];
    const desktop = matchMedia('(min-width: 901px)');
    let current = 0;
    let timer: number | undefined;

    const activate = (i: number) => {
      current = i;
      items.forEach((item, n) => {
        item.classList.toggle('is-open', n === i);
        item.querySelector('button')!.setAttribute('aria-expanded', String(n === i));
      });
      slides.forEach((s) => s.classList.toggle('is-active', Number(s.dataset.slide) === i));
    };
    const stop = () => clearInterval(timer);

    items.forEach((item, i) => {
      const button = item.querySelector('button')!;
      button.addEventListener('click', () => {
        stop();
        activate(i);
      });
      button.addEventListener('mouseenter', () => {
        if (!desktop.matches) return;
        stop();
        activate(i);
      });
    });

    // Auto-advance while on screen on desktop, until the visitor takes over.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      new IntersectionObserver(([entry]) => {
        stop();
        if (entry.isIntersecting && desktop.matches) {
          timer = window.setInterval(() => activate((current + 1) % items.length), 6500);
        }
      }, { threshold: 0.4 }).observe(lux);
      lux.addEventListener('pointerdown', stop, { once: true });
    }
  }

  // Gentle parallax on full-bleed images.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const layers = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
    const onScroll = () => {
      for (const bg of layers) {
        const r = bg.parentElement!.getBoundingClientRect();
        if (r.bottom < 0 || r.top > innerHeight) continue;
        const progress = (r.top + r.height / 2 - innerHeight / 2) / innerHeight;
        bg.style.transform = `translate3d(0, ${progress * -50}px, 0)`;
      }
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
