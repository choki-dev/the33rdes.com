---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BookingBar from '../components/BookingBar.astro';
import Icon from '../components/Icon.astro';
import logoLight from '../assets/logo-light.png';
import logoDark from '../assets/logo-dark.png';
import { attractionCategories, attractions, experiences, rooms, site, stats, stayIncludes } from '../data/site';
import { img } from '../lib/images';
import { slugify } from '../lib/slugify';

const featuredPlaces = attractions.filter((a) => a.featured).slice(0, 4);

const xp = Object.fromEntries(experiences.map((e) => [e.slug, e]));
const signature = rooms.find((r) => r.featured) ?? rooms[0];
const otherRooms = rooms.filter((r) => r !== signature);

// Hero slideshow: the first photo is the page's main image; the rest load quietly behind it.
const heroSlides = [
  { key: 'valley-1', alt: 'A sitting room looking out across the valley to the nunnery' },
  { key: 'lobby-2', alt: 'The lobby lounge with floor-to-ceiling windows onto the hills' },
  { key: 'valley-suite-1', alt: 'The Valley Suite bedroom' },
  { key: 'dining-4', alt: 'Artisan’s Table restaurant laid for dinner' },
  { key: 'lobby-1', alt: 'The hotel lobby with a traditional Bhutanese thangka' },
];

const chapters = [
  {
    kicker: 'Taste',
    title: 'Vegetarian Menu',
    text: [
      'Every dish at The 33rd is pure vegetarian — Indian, Western, Thai and gourmet artisanal plates, with vegan-friendly choices throughout and innovative meat alternatives, all from a strictly pathogen-free kitchen.',
    ],
    meta: `100% vegetarian · ${xp['artisans-table'].location}`,
    image: 'food-steak',
    inset: 'food-mushroom',
    links: [
      { label: 'View the menu', href: '/experiences/artisans-table#menu' },
      { label: 'Reserve a table', href: site.phoneHref },
    ],
  },
  {
    kicker: 'Dine',
    title: 'Artisan’s Table',
    text: [xp['artisans-table'].intro],
    meta: `${xp['artisans-table'].location} · Breakfast ${xp['artisans-table'].hours[0].value}`,
    image: 'dining-4',
    inset: 'food-thali',
    links: [
      { label: 'Read more', href: '/experiences/artisans-table' },
      { label: 'Reserve a table', href: site.phoneHref },
    ],
  },
  {
    kicker: 'Unwind',
    title: 'Salts Rooftop Bar',
    text: [xp['salts-rooftop-bar'].intro],
    meta: `${xp['salts-rooftop-bar'].location} · ${xp['salts-rooftop-bar'].hours[0].value}`,
    image: 'spa-1',
    inset: 'home-2',
    links: [{ label: 'Read more', href: '/experiences/salts-rooftop-bar' }],
  },
  {
    kicker: 'Restore',
    title: 'Om Spa & Fitness',
    text: [
      `${xp['om-spa'].intro} Skilled therapists offer personalised treatments to ease tension and restore balance.`,
      `Our fully equipped fitness centre is open daily, ${xp['gym'].hours[0].value}.`,
    ],
    meta: `${xp['om-spa'].location} · Spa ${xp['om-spa'].hours[0].value}`,
    image: 'spa-3',
    inset: 'gym-1',
    links: [
      { label: 'Read more', href: '/experiences/om-spa' },
      { label: 'Book a treatment', href: site.phoneHref },
    ],
  },
  {
    kicker: 'Gather',
    title: 'The Boardroom',
    text: [xp['the-boardroom'].intro],
    meta: `${xp['the-boardroom'].location} · Up to 100 guests`,
    image: 'board-6',
    inset: 'spa-2',
    links: [
      { label: 'Read more', href: '/experiences/the-boardroom' },
      { label: 'Plan an event', href: site.phoneHref },
    ],
  },
];
---
<Base>
  <!-- ============ HERO: logo-led, over a photo slideshow ============ -->
  <section class="hero" aria-label="Welcome">
    <div class="hero__media" data-hero-slides>
      {heroSlides.map((s, i) => (
        <div class:list={['hero__slide', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
          <Image
            src={img(s.key)}
            alt={s.alt}
            widths={[800, 1400, 2000, 2560]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'low'}
          />
        </div>
      ))}
    </div>
    <div class="hero__veil"></div>

    <div class="hero__content">
      <h1 class="hero__logo">
        <Image src={logoLight} alt={site.name} width={420} loading="eager" fetchpriority="high" />
      </h1>
      <p class="hero__tag"><span>A boutique luxury hotel</span><span class="hero__sep" aria-hidden="true">&nbsp;·&nbsp;</span><span>Thimphu, Bhutan</span></p>
    </div>

    <div class="hero__bar container">
      <BookingBar variant="hero" />
    </div>

    <button class="hero__sound" type="button" aria-label="Pause slideshow" data-hero-toggle>
      <Icon name="pause" size={14} />
    </button>
  </section>

  <!-- ============ INTRO BAND ============ -->
  <section class="intro">
    <div class="container intro__inner reveal">
      <Image src={logoDark} alt="" width={360} class="intro__mark" />
      <h2 class="intro__title">Welcome to The 33rd Executive Suites</h2>
      <p class="intro__tag">Thoughtful Living. Conscious Comfort. Quiet Elegance.</p>
      <div class="intro__line">
        <p>Nestled in the serene city of Thimphu, The 33rd Executive Suites is a 4-star hotel where contemporary comfort meets conscious living. Designed for discerning travelers, we offer a refined and welcoming experience rooted in wellness, sustainability, and mindful hospitality.</p>
        <p>As one of Bhutan’s few hotels dedicated to a 100% vegetarian and vegan-friendly experience, we believe that exceptional hospitality goes beyond comfort, it reflects a deeper respect for people, the planet, and the choices we make.</p>
        <p>With personalized service, international standards of care, and an atmosphere of understated elegance, every stay is thoughtfully crafted to help you feel at ease.</p>
        <p>More than a place to stay, The 33rd is a place to reconnect with yourself, your values, and the journey that brings you here.</p>
      </div>
      <ul class="intro__stats">
        {stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- ============ SIGNATURE SUITE: full-bleed photo, floating card ============ -->
  <section class="sig" aria-label={signature.name}>
    <div class="sig__media" data-parallax>
      <Image src={img(signature.hero)} alt={`${signature.name} — looking out to the nunnery`} widths={[900, 1400, 2000, 2400]} sizes="100vw" />
    </div>
    <div class="container sig__wrap">
      <article class="sig__card reveal">
        <span class="eyebrow">Signature suite</span>
        <h2>{signature.name}</h2>
        <p>{signature.description}</p>
        <ul class="sig__meta">
          <li><Icon name="view" size={16} />{signature.view}</li>
          <li><Icon name="bed" size={16} />{signature.bed}</li>
          <li><Icon name="size" size={16} />{signature.size}</li>
        </ul>
        <div class="sig__foot">
          <a class="btn" href={`/book?room=${signature.slug}`}>Book this suite</a>
          <a class="link-arrow" href={`/rooms/${signature.slug}`}>Discover</a>
        </div>
      </article>
    </div>
  </section>

  <!-- ============ ROOMS: staggered portrait cards ============ -->
  <section class="section rooms">
    <div class="container">
      <header class="rooms__head reveal">
        <div>
          <span class="eyebrow">Rooms</span>
          <h2>Rooms &amp; <em>Suites</em></h2>
        </div>
        <div>
          <p>Sixty-eight rooms across two towers, each with a mini kitchen, bathtub and every comfort for leisure or business.</p>
          <a class="link-arrow" href="/rooms">View all rooms <Icon name="arrow" /></a>
        </div>
      </header>
    </div>
    <div class="suites" data-suites>
      {otherRooms.map((room) => (
        <article class="suite">
          <a href={`/rooms/${room.slug}`} class="suite__media media" aria-label={room.name}>
            <Image src={img(room.hero)} alt={room.name} widths={[600, 900, 1300]} sizes="(max-width: 700px) 88vw, 760px" />
          </a>
          <div class="suite__card">
            <h3><a href={`/rooms/${room.slug}`}>{room.name}</a></h3>
            <ul class="suite__meta">
              <li><Icon name="size" size={15} />{room.size}</li>
              <li><Icon name="bed" size={15} />{room.bed}</li>
              <li><Icon name="user" size={15} />{room.capacity} guests</li>
            </ul>
            <div class="suite__foot">
              <div class="suite__links">
                <a class="link-arrow" href={`/rooms/${room.slug}`}>Discover</a>
                <a class="link-arrow" href={`/book?room=${room.slug}`}>Book</a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="container suites__controls">
      <div class="suites__progress" aria-hidden="true"><span data-suites-bar></span></div>
      <div class="suites__nav">
        <button type="button" class="circle-btn" data-suites-step="-1" aria-label="Previous room">&#8592;</button>
        <button type="button" class="circle-btn" data-suites-step="1" aria-label="Next room">&#8594;</button>
      </div>
    </div>
  </section>

  <!-- ============ EXPERIENCES: dark, immersive showcase ============ -->
  <section class="lux" aria-labelledby="lux-title" data-lux>
    <div class="container lux__head reveal">
      <span class="eyebrow eyebrow--center">The 33rd experience</span>
      <h2 id="lux-title">Dine, unwind, <em>restore</em> &amp; gather</h2>
      <p>A pure vegetarian menu and four spaces, one quiet standard of care — from the table to a rooftop seven floors above Thimphu.</p>
    </div>

    <div class="container lux__grid">
      <div class="lux__stage reveal" aria-hidden="true">
        <div class="lux__frame">
          {chapters.map((c, i) => (
            <div class:list={['lux__slide', { 'is-active': i === 0 }]} data-slide={i}>
              <Image src={img(c.image)} alt="" widths={[600, 900, 1300]} sizes="42vw" />
            </div>
          ))}
        </div>
        <div class="lux__inset">
          {chapters.map((c, i) => (
            <div class:list={['lux__slide', { 'is-active': i === 0 }]} data-slide={i}>
              <Image src={img(c.inset)} alt="" widths={[300, 500]} sizes="15vw" />
            </div>
          ))}
        </div>
      </div>

      <ol class="lux__list">
        {chapters.map((c, i) => (
          <li class:list={['lux__item', { 'is-open': i === 0 }]} data-item={i}>
            <button class="lux__trigger" type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`lux-panel-${i}`}>
              <span class="lux__name">{c.title}<small>{c.kicker}</small></span>
              <span class="lux__plus" aria-hidden="true"></span>
            </button>
            <div class="lux__panel" id={`lux-panel-${i}`}>
              <div class="lux__panel-inner">
                <div class="lux__mobile-img media">
                  <Image src={img(c.image)} alt={c.title} widths={[500, 800]} sizes="100vw" />
                </div>
                <p>{c.text[0]}</p>
                <p class="lux__meta">{c.meta}</p>
                <div class="lux__links">
                  {c.links.map((l) => <a class="link-arrow" href={l.href}>{l.label}</a>)}
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ STATEMENT: green veg band, plates + spinning badge ============ -->
  <section class="veg" aria-label="Pure vegetarian dining">
    <div class="container veg__grid">
      <div class="veg__plates reveal" aria-hidden="true">
        <div class="veg__plate veg__plate--lg"><Image src={img('food-zheycha')} alt="" widths={[400, 700]} sizes="(max-width: 860px) 70vw, 420px" /></div>
        <div class="veg__plate veg__plate--sm"><Image src={img('food-salad')} alt="" widths={[300, 500]} sizes="200px" /></div>
        <div class="veg__plate veg__plate--xs"><Image src={img('food-mango')} alt="" widths={[200, 400]} sizes="140px" /></div>
        <svg class="veg__badge" viewBox="0 0 200 200">
          <circle class="veg__disc" cx="100" cy="100" r="99" />
          <defs><path id="veg-ring" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
          <text><textPath href="#veg-ring">100% pure vegetarian · vegan friendly · </textPath></text>
          <path class="veg__leaf" d="M100 72c-20 12-26 34-14 52 18-4 30-20 30-40 0-5-1-9-2-12-5 0-10 0-14 0Zm-14 52c8-14 16-24 26-32" />
        </svg>
      </div>
      <div class="veg__text reveal reveal-delay-1">
        <span class="veg__eyebrow">Pure vegetarian dining</span>
        <blockquote>“Fresh, creative and wholesome — every meal at The 33rd is <em>pure vegetarian</em>, and every one is made to be remembered.”</blockquote>
        <ul class="veg__tags">
          <li>Locally sourced</li>
          <li>Vegan friendly</li>
          <li>Bhutanese &amp; world flavours</li>
        </ul>
        <a class="veg__link" href="/experiences/artisans-table">Explore the Artisan’s Table <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- ============ SUGAR BOX: centred text, triptych ============ -->
  <section class="section bakery">
    <div class="container container--narrow center reveal">
      <span class="eyebrow eyebrow--center">In-house bakery</span>
      <h2>Sugar Box <em>Café</em></h2>
      <p class="lead">{xp['sugar-box-cafe'].intro.split(/(?<=\.)\s+/).slice(0, 2).join(' ')}</p>
    </div>
    <div class="container triptych">
      {['cafe-3', 'home-1', 'cafe-1'].map((key, i) => (
        <a href="/experiences/sugar-box-cafe" class:list={['triptych__item media reveal', `reveal-delay-${i}`]}>
          <Image src={img(key)} alt="Sugar Box Café" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 33vw" />
        </a>
      ))}
    </div>
    <div class="center"><a class="link-arrow" href="/experiences/sugar-box-cafe">Read more</a></div>
  </section>

  <!-- ============ STAYS INCLUDE ============ -->
  <section class="section includes">
    <div class="container includes__grid">
      <div class="reveal">
        <span class="eyebrow">Every stay includes</span>
        <h2>Thoughtful details, <em>as standard</em></h2>
        <a class="btn" href="/book">Plan your stay</a>
      </div>
      <ol class="includes__list">
        {stayIncludes.map((it, i) => (
          <li class:list={['reveal', `reveal-delay-${i % 2}`]}>
            <strong>{it.title}</strong>
            <p>{it.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ DISCOVER THIMPHU ============ -->
  <section class="discover" aria-labelledby="discover-title">
    <div class="band__wrap">
      <header class="band__head reveal">
        <h2 id="discover-title">Discover Thimphu</h2>
        <span class="band__sub">The capital, on your doorstep</span>
      </header>

      <div class="discover__row reveal">
        <div class="discover__panel">
          <span class="band__label">Destination</span>
          <p>Ancient dzongs and a golden Buddha above the valley, Himalayan passes, forest trails and a weekend farmers’ market — Bhutan’s capital is a city of quiet wonders, and most of them are within minutes of your suite.</p>
          <ul class="discover__cats">
            {attractionCategories.map((c) => (
              <li>
                <strong>{attractions.filter((a) => a.category === c.slug).length}</strong>
                <span>{c.label}</span>
              </li>
            ))}
          </ul>
          <a class="band__link" href="/destination">Explore Thimphu</a>
        </div>

        <div class="slides" data-slides aria-roledescription="carousel" aria-label="Places to visit in Thimphu">
          {featuredPlaces.map((a, i) => (
            <a
              href={`/destination#${slugify(a.name)}`}
              class:list={['slide', { 'is-active': i === 0 }]}
              data-slide
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${featuredPlaces.length}: ${a.name}`}
              aria-hidden={i === 0 ? undefined : 'true'}
              tabindex={i === 0 ? undefined : -1}
            >
              <Image src={img(a.image)} alt="" widths={[600, 900, 1300]} sizes="(max-width: 900px) 100vw, 780px" />
              <span class="slide__caption">
                <span>{a.distance}</span>
                <strong>{a.name}</strong>
              </span>
            </a>
          ))}
          <button type="button" class="slides__arrow slides__arrow--prev" data-slides-step="-1" aria-label="Previous place">&#8249;</button>
          <button type="button" class="slides__arrow slides__arrow--next" data-slides-step="1" aria-label="Next place">&#8250;</button>
          <span class="slides__count" aria-hidden="true"><b data-slides-current>01</b> / {String(featuredPlaces.length).padStart(2, '0')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ OUR STORY ============ -->
  <section class="story" aria-labelledby="story-title">
    <div class="band__wrap">
      <div class="story__trio">
        <div class="story__tile reveal">
          <Image src={img('about-2')} alt="A sitting area looking out over the valley" widths={[400, 700]} sizes="(max-width: 1000px) 50vw, 420px" />
          <span class="story__caption">Relax</span>
        </div>

        <div class="story__panel reveal reveal-delay-1">
          <h2 id="story-title">Our Story</h2>
          <p class="story__quote">“A place to rest — and a place to <em>reconnect</em> with yourself, your values and your journey.”</p>
          <p>With attentive, personalised service and a standard of care that meets international expectations, The 33rd is where comfort, integrity and quiet elegance come together — adorned with original artwork and rooted in sustainability.</p>
          <a class="band__link" href="/about">Read more</a>
        </div>

        <div class="story__tile reveal reveal-delay-2">
          <Image src={img('deluxe-standard-1')} alt="Twin beds in a sunlit guest room" widths={[400, 700]} sizes="(max-width: 1000px) 50vw, 420px" />
          <span class="story__caption">Rejuvenate</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative; min-height: 100svh; display: grid; grid-template-rows: 1fr auto;
    color: var(--ivory); background: #000;
  }
  /* Only the photos are clipped, so the booking bar's calendar can open below the hero on phones. */
  .hero__media { position: absolute; inset: 0; overflow: hidden; }
  /* Slides crossfade; each one drifts in slowly while it is on screen. */
  .hero__slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.6s var(--ease); }
  .hero__slide.is-active { opacity: .72; }
  .hero__slide :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.08); transition: transform 8s linear; }
  .hero__slide.is-active :global(img) { transform: scale(1); }
  .hero.is-paused .hero__slide :global(img) { transition: none; }
  @media (prefers-reduced-motion: reduce) {
    .hero__slide, .hero__slide :global(img) { transition: none; transform: none; }
  }
  .hero__veil {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 50% 45% at center 45%, rgba(0, 0, 0, .62), rgba(0, 0, 0, .3) 70%, rgba(0, 0, 0, .5)),
      linear-gradient(to bottom, rgba(0, 0, 0, .45), transparent 30%, transparent 60%, rgba(0, 0, 0, .65));
  }
  .hero__content {
    position: relative; align-self: center; text-align: center;
    padding: calc(var(--header-h) + 24px) var(--gutter) 24px;
  }
  .hero__logo { margin: 0 auto; width: clamp(140px, 17vw, 230px); animation: rise 1.8s var(--ease-out) .3s both; }
  .hero__logo :global(img) { width: 100%; height: auto; filter: drop-shadow(0 6px 30px rgba(0, 0, 0, .35)); }
  .hero__tag {
    margin: 28px 0 0; font-size: .74rem; letter-spacing: .34em; text-transform: uppercase; color: #e8e2d6;
    animation: rise 1.6s var(--ease-out) .7s both;
  }
  /* Bottom padding clears the floating WhatsApp button, so it never sits on Check availability. */
  .hero__bar { position: relative; z-index: 5; padding-bottom: 104px; animation: rise 1.4s var(--ease-out) 1s both; }
  .hero__sound {
    position: absolute; right: var(--gutter); top: calc(var(--header-h) + 24px);
    width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(0, 0, 0, .3); border: 1px solid rgba(250, 247, 241, .4); color: var(--ivory); cursor: pointer;
  }
  .hero__sound:hover { background: rgba(0, 0, 0, .6); }
  @keyframes rise { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }
  @media (max-width: 640px) {
    .hero__tag { font-size: .7rem; letter-spacing: .2em; line-height: 2; }
    /* Two clean lines instead of a stray dot at a line end. */
    .hero__tag span { display: block; }
    .hero__tag .hero__sep { display: none; }
  }
  /* Phones hide the floating WhatsApp button (the bottom bar has one), so the booking bar can sit low again. */
  @media (max-width: 600px) {
    .hero__bar { padding-bottom: 24px; }
  }

  /* ---------- Intro band ---------- */
  .intro { background: var(--white); padding-block: clamp(56px, 7vw, 96px); text-align: center; }
  .intro__inner { display: flex; flex-direction: column; align-items: center; }
  .intro__mark { width: 176px; height: auto; margin-bottom: 28px; }
  .intro__title { margin-bottom: 12px; font-size: clamp(1.7rem, 3vw, 2.5rem); }
  .intro__tag { margin-bottom: 28px; font-size: .7rem; letter-spacing: .28em; text-transform: uppercase; color: var(--gold-deep); }
  .intro__line { max-width: 68ch; color: var(--muted); font-size: .92rem; line-height: 1.9; margin-bottom: 36px; }
  .intro__line p { margin: 0 0 1.1em; }
  .intro__line p:last-child { margin-bottom: 0; }
  .intro__stats {
    list-style: none; padding: 26px 0 0; margin: 0; width: 100%; max-width: 900px;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px 20px;
    border-top: 1px solid var(--stone);
  }
  @media (max-width: 600px) { .intro__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .intro__stats li { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .intro__stats strong { font-family: var(--font-display); font-weight: 400; font-size: 2rem; line-height: 1; color: var(--gold-deep); }
  .intro__stats span { font-size: .64rem; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); max-width: 20ch; }

  /* ---------- Shared ---------- */

  /* ---------- Signature suite ---------- */
  .sig { position: relative; min-height: clamp(560px, 92vh, 860px); display: flex; align-items: flex-end; overflow: hidden; background: var(--ink); }
  .sig__media { position: absolute; inset: -8% 0; }
  .sig__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .sig__wrap { position: relative; display: flex; justify-content: flex-end; padding-block: clamp(32px, 6vw, 80px); }
  .sig__card { width: min(480px, 100%); background: var(--white); padding: clamp(28px, 4vw, 52px); }
  .sig__card h2 { margin-bottom: 14px; }
  .sig__card > p { color: var(--muted); font-size: .9rem; }
  .sig__meta { list-style: none; padding: 16px 0; margin: 0 0 24px; display: flex; flex-wrap: wrap; gap: 8px 22px; border-block: 1px solid var(--stone); font-size: .8rem; }
  .sig__meta li { display: flex; align-items: center; gap: 8px; }
