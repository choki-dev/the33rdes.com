---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Lightbox from '../../components/Lightbox.astro';
import Filmstrip from '../../components/Filmstrip.astro';
import Icon from '../../components/Icon.astro';
import AmenityTiles from '../../components/AmenityTiles.astro';
import { rooms, site } from '../../data/site';
import { img } from '../../lib/images';

export function getStaticPaths() {
  return rooms.map((room) => ({ params: { slug: room.slug }, props: { room } }));
}

const { room } = Astro.props;
const others = rooms.filter((r) => r.slug !== room.slug);
const perks = ['Daily vegetarian breakfast', room.noKitchen ? 'High-speed Wi-Fi' : 'High-speed Wi-Fi & kitchenette', 'Fitness centre access', 'Personal, attentive service'];
---
<Base title={room.name} description={`${room.name} in Babesa, Thimphu: ${room.size}, ${room.bed} bed, ${room.view.toLowerCase()}, for up to ${room.capacity} guests. ${room.description}`} image={img(room.hero)} imageAlt={`${room.name} at ${site.name}, Thimphu`}>
  <PageHero image={img(room.hero)} eyebrow={`Rooms & Suites · ${room.view}`} title={room.name} subtitle={room.tagline} />

  <section class="section">
    <div class="container detail">
      <div class="detail__main reveal">
        <span class="eyebrow">Overview</span>
        <h2>{room.tagline?.replace(/\.$/, '') ?? `The ${room.name}`}</h2>
        <p class="lead">{room.description}</p>

        <ul class="facts">
          <li><Icon name="size" /><small>Room size</small><strong>{room.size}</strong></li>
          <li><Icon name="bed" /><small>Bedding</small><strong>{room.bed}</strong></li>
          <li><Icon name="user" /><small>Occupancy</small><strong>{room.capacity} guests</strong></li>
          <li><Icon name="view" /><small>Outlook</small><strong>{room.view}</strong></li>
        </ul>

        <div class="amen-wrap">
          <div class="amen-head">
            <span class="eyebrow">In every room</span>
            <h3>Room amenities</h3>
          </div>
          <AmenityTiles noKitchen={room.noKitchen} />
        </div>
      </div>

      <aside class="detail__aside">
        <div class="bookcard reveal reveal-delay-1">
          <span class="label">Reserve</span>
          <p class="bookcard__title">{room.name}</p>
          <ul>
            {perks.map((p) => <li><Icon name="check" size={16} /><span>{p}</span></li>)}
          </ul>
          <a class="btn btn--block" href={`/book?room=${room.slug}`}>Check availability</a>
          <a class="btn btn--outline btn--block" href={site.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> Ask on WhatsApp</a>
          <p class="bookcard__note">Check-in {site.checkIn} · Check-out {site.checkOut}<br />We reply with availability and our best rate.</p>
        </div>
      </aside>
    </div>
  </section>

  <Filmstrip images={room.images} caption={room.name} title={`Inside the <em>${room.short}</em>`} />

  <section class="section more">
    <div class="container">
      <header class="more__head reveal">
        <div>
          <span class="eyebrow">You may also like</span>
          <h2>Other <em>rooms</em></h2>
        </div>
        <a class="link-arrow" href="/rooms">All rooms &amp; suites</a>
      </header>
      <div class="more__row">
        {others.map((r, i) => (
          <a href={`/rooms/${r.slug}`} class:list={['mcard reveal', `reveal-delay-${i % 4}`]}>
            <Image src={img(r.hero)} alt={r.name} widths={[400, 700]} sizes="(max-width: 640px) 80vw, (max-width: 1000px) 45vw, 25vw" />
            <div class="mcard__body">
              <span class="mcard__view">{r.view}</span>
              <h3>{r.name}</h3>
              <ul class="mcard__facts">
                <li>{r.size}</li>
                <li>{r.bed}</li>
                <li>{r.capacity} guests</li>
              </ul>
              <span class="mcard__cta">View room <Icon name="arrow" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Lightbox />
</Base>

<style>
  .detail { display: grid; grid-template-columns: 1fr 380px; gap: clamp(40px, 7vw, 110px); align-items: start; }
  .detail > * { min-width: 0; }
  .detail__main .lead { color: var(--charcoal); }
  .facts { list-style: none; padding: 0; margin: 48px 0; display: grid; grid-template-columns: repeat(4, 1fr); border-block: 1px solid var(--stone); }
  .facts li { padding: 28px 16px 28px 0; display: flex; flex-direction: column; gap: 6px; }
  .facts li + li { padding-left: 20px; border-left: 1px solid var(--stone); }
  .facts :global(svg) { color: var(--gold); margin-bottom: 6px; }
  .facts small { font-family: var(--font-ui); font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  .facts strong { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-detail); color: var(--ink); line-height: 1.2; }
  .detail h3 { font-size: var(--fs-card); }
  /* Amenities: icon tiles (AmenityTiles) on a sand panel. */
  .amen-wrap { padding: clamp(18px, 2.4vw, 28px); background: var(--sand); }
  .amen-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 24px; margin-bottom: 20px; }
  .amen-head .eyebrow { order: 2; margin: 0; }
  .amen-head h3 { margin: 0; }

  .detail__aside { position: sticky; top: calc(var(--header-h) + 24px); }
  .bookcard { background: var(--ink); color: #cfc8bb; padding: 40px 36px; display: grid; gap: 14px; }
  .bookcard .label { color: var(--gold); }
  .bookcard__title { margin: 0 0 8px; font-family: var(--font-display); font-size: var(--fs-card); line-height: 1.2; color: var(--ivory); }
  .bookcard ul { list-style: none; margin: 0 0 12px; padding: 0; display: grid; gap: 14px; }
  .bookcard li { display: flex; gap: 12px; font-size: .88rem; line-height: 1.5; }
  .bookcard li :global(svg) { color: var(--gold); flex: none; margin-top: 3px; }
  .bookcard .btn--outline { --btn-fg: var(--ivory); --btn-bd: rgba(250, 247, 241, .4); }
  .bookcard .btn--outline::before { background: var(--ivory); }
  .bookcard .btn--outline:hover { color: var(--ink); }
  .bookcard__note { margin: 8px 0 0; font-size: .8rem; color: #8f887b; text-align: center; }


  /* Other rooms: tall photo cards, details rise on hover. */
  .more { background: var(--sand); }
  .more__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 40px; margin-bottom: 40px; }
  .more__head h2 { margin: 0; }
  .more__row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .mcard { position: relative; display: block; aspect-ratio: 3 / 4; overflow: hidden; background: var(--ink); color: var(--ivory); }
  .mcard :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease-out), opacity .6s; }
  .mcard::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(15, 14, 12, .85), rgba(15, 14, 12, .1) 55%, transparent); transition: background .6s; }
  .mcard:hover :global(img) { transform: scale(1.06); opacity: .75; }
  .mcard__body { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: 24px 22px; transform: translateY(44px); transition: transform .6s var(--ease); }
  .mcard:hover .mcard__body, .mcard:focus-visible .mcard__body { transform: none; }
  .mcard__view { display: block; margin-bottom: 6px; font-size: .58rem; letter-spacing: .22em; text-transform: uppercase; color: var(--gold-soft); }
  .mcard h3 { margin: 0 0 12px; font-size: clamp(1.3rem, 1.7vw, 1.55rem); color: var(--ivory); }
  .mcard__facts { list-style: none; margin: 0 0 18px; padding: 12px 0 0; display: flex; flex-wrap: wrap; gap: 4px 14px; border-top: 1px solid rgba(216, 199, 156, .35); font-size: .74rem; color: #ddd6c8; }
  .mcard__facts li + li::before { content: '·'; margin-right: 14px; color: var(--gold); }
  .mcard__cta { display: inline-flex; align-items: center; gap: 10px; font-size: .62rem; letter-spacing: .22em; text-transform: uppercase; color: var(--gold-soft); opacity: 0; transition: opacity .5s; }
  .mcard:hover .mcard__cta, .mcard:focus-visible .mcard__cta { opacity: 1; }
  @media (hover: none) {
    .mcard__body { transform: none; }
    .mcard__cta { opacity: 1; }
  }
  @media (max-width: 1000px) {
    .more__row {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 45%;
      overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 4px;
    }
    .more__row::-webkit-scrollbar { display: none; }
    .mcard { scroll-snap-align: start; }
  }
  @media (max-width: 640px) { .more__row { grid-auto-columns: 80%; } }

  @media (max-width: 1000px) {
    .detail { grid-template-columns: 1fr; }
    .detail__aside { position: static; }
    .facts { grid-template-columns: 1fr 1fr; }
    .facts li + li:nth-child(3) { padding-left: 0; border-left: 0; }
    .facts li:nth-child(-n + 2) { border-bottom: 1px solid var(--stone); }
    .facts li { padding-block: 20px; }
  }
</style>
