---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource/montserrat/300.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import garamondLatin from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';
import montserratLatin from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBookBar from '../components/MobileBookBar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site } from '../data/site';
import { hotel, hotelId, hotelRef, defaultShareImage, shareSize } from '../lib/schema';
import { assetUrl, base, pageUrl } from '../lib/urls';

interface Props {
  title?: string;
  description?: string;
  /** Share image: a path under /public or a photo from src/assets (resized to 1200px wide). Defaults to the valley photo. */
  image?: string | ImageMetadata;
  imageAlt?: string;
  /** Keep the page out of search results (404, booking and availability steps). */
  noindex?: boolean;
  /** Header starts transparent over a dark hero. */
  overlayHeader?: boolean;
}
const {
  title,
  description: fullDescription = site.description,
  image,
  imageAlt,
  noindex = false,
  overlayHeader = true,
} = Astro.props;
// Search results show about 160 characters: keep the first sentence(s) that fit, else cut at a word.
const clip = (text: string, max = 158) => {
  if (text.length <= max) return text;
  const sentences = text.match(/[^.!?]+[.!?]+/g) ?? [];
  let out = '';
  for (const s of sentences) if ((out + s).trim().length <= max) out += s; else break;
  const cut = text.lastIndexOf(' ', max - 1);
  return out.trim() || text.slice(0, cut > 0 ? cut : max - 1).replace(/[\s,;:—–-]+$/, '') + '…';
};
const description = clip(fullDescription);
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Boutique Hotel in Thimphu, Bhutan`;
const path = Astro.url.pathname.slice(base.length) || '/';
const canonical = pageUrl(path);
const ogImage =
  image === undefined ? defaultShareImage : assetUrl(typeof image === 'string' ? image : (await getImage({ src: image, ...shareSize })).src);

// Breadcrumbs from the URL: Home › section › page.
const sectionNames: Record<string, string> = { rooms: 'Rooms & Suites', experiences: 'Experiences' };
const segments = path.split('/').filter(Boolean);
const breadcrumbs = segments.length && {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { name: 'Home', path: '/' },
    ...segments.map((s, i) => ({
      name: i === segments.length - 1 ? (title ?? s) : (sectionNames[s] ?? s),
      path: '/' + segments.slice(0, i + 1).join('/'),
    })),
  ].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: pageUrl(c.path) })),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    path === '/' ? hotel : hotelRef,
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: pageUrl('/'), name: site.name, publisher: { '@id': hotelId }, inLanguage: 'en' },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: fullTitle,
      description,
      isPartOf: { '@id': `${site.url}/#website` },
      about: { '@id': hotelId },
      primaryImageOfPage: ogImage,
      inLanguage: 'en',
    },
    breadcrumbs,
  ].filter(Boolean),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <!-- Latin faces used above the fold; the other subsets load only if a page needs them. -->
    <link rel="preload" as="font" type="font/woff2" href={garamondLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={montserratLatin} crossorigin />
    <!-- ?v= busts icons cached from other sites previously served on the same host -->
    <link rel="icon" href="/favicon.ico?v=33rd" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=33rd" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png?v=33rd" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=33rd" />
    <meta name="theme-color" content="#1d1c1a" />
    <meta name="geo.region" content="BT-15" />
    <meta name="geo.placename" content="Thimphu, Bhutan" />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt ?? title ?? site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBookBar />
    <WhatsAppFloat />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
