---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource/montserrat/300.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import garamondLatin from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';
import montserratLatin from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBookBar from '../components/MobileBookBar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { experiences, rooms, site } from '../data/site';
import { img } from '../lib/images';

interface Props {
  title?: string;
  description?: string;
  /** Share image: a path under /public or a photo from src/assets (resized to 1200px wide). */
  image?: string | ImageMetadata;
  imageAlt?: string;
  /** Keep the page out of search results (404, booking steps). */
  noindex?: boolean;
  /** Header starts transparent over a dark hero. */
  overlayHeader?: boolean;
}
const {
  title,
  description: fullDescription = site.description,
  image = img('valley-1'),
  imageAlt,
  noindex = false,
  overlayHeader = true,
} = Astro.props;
// Search results show about 160 characters: keep the first sentence(s) that fit, else cut at a word.
const clip = (text: string, max = 158) => {
  if (text.length <= max) return text;
  const sentences = text.match(/[^.!?]+[.!?]+/g) ?? [];
  let out = '';
  for (const s of sentences) if ((out + s).trim().length <= max) out += s; else break;
  return out.trim() || text.slice(0, text.lastIndexOf(' ', max - 1)).replace(/[\s,;:—–-]+$/, '') + '…';
};
const description = clip(fullDescription);
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} — Luxury Boutique Hotel in Thimphu, Bhutan`;
const path = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length) || '/';
const canonical = new URL(path, site.url).toString();
const shareImage = typeof image === 'string' ? image : (await getImage({ src: image, width: 1200, format: 'jpg', quality: 80 })).src;
const ogImage = new URL(shareImage, site.url).toString();

const hotelId = `${site.url}/#hotel`;
const hotel = {
  '@type': 'Hotel',
  '@id': hotelId,
  name: site.name,
  alternateName: site.shortName,
  description: site.description,
  slogan: site.tagline,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  image: new URL((await getImage({ src: img('valley-1'), width: 1200, format: 'jpg', quality: 80 })).src, site.url).toString(),
  logo: new URL('/favicon.png', site.url).toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: 'Thimphu',
    postalCode: site.address.postalCode,
    addressCountry: 'BT',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.mapUrl,
  areaServed: { '@type': 'City', name: 'Thimphu' },
  checkinTime: '14:00',
  checkoutTime: '12:00',
  numberOfRooms: 68,
  servesCuisine: ['Vegetarian', 'Vegan', 'Bhutanese'],
  amenityFeature: ['Spa', 'Rooftop bar', 'Restaurant', 'Vegetarian restaurant', 'Fitness centre', 'Free Wi-Fi', 'Free parking', 'Meeting room', '24-hour room service', 'Airport transfer'].map((name) => ({
    '@type': 'LocationFeatureSpecification',
    name,
    value: true,
  })),
  containsPlace: [
    ...rooms.map((r) => ({
      '@type': 'HotelRoom',
      name: r.name,
      url: new URL(`/rooms/${r.slug}/`, site.url).toString(),
      description: r.description,
      occupancy: { '@type': 'QuantitativeValue', maxValue: r.capacity },
      bed: r.bed,
    })),
    ...experiences.map((x) => ({ '@type': 'Place', name: x.name, description: x.kind, url: new URL(`/experiences/${x.slug}/`, site.url).toString() })),
  ],
  sameAs: Object.values(site.social),
};

// Breadcrumbs from the URL: Home › section › page.
const sectionNames: Record<string, string> = { rooms: 'Rooms & Suites', experiences: 'Experiences' };
const segments = path.split('/').filter(Boolean);
const crumbs = segments.length
  ? [
      { name: 'Home', url: site.url + '/' },
      ...segments.map((s, i) => ({
        name: i === segments.length - 1 ? (title ?? s) : (sectionNames[s] ?? s),
        url: new URL('/' + segments.slice(0, i + 1).join('/') + '/', site.url).toString(),
      })),
    ]
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    hotel,
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.name, publisher: { '@id': hotelId }, inLanguage: 'en' },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: fullTitle,
      description,
      isPartOf: { '@id': `${site.url}/#website` },
      about: { '@id': hotelId },
      primaryImageOfPage: ogImage,
      inLanguage: 'en',
    },
    ...(crumbs.length
      ? [{ '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })) }]
      : []),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <!-- Latin faces used above the fold; the other subsets load only if a page needs them. -->
    <link rel="preload" as="font" type="font/woff2" href={garamondLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={montserratLatin} crossorigin />
    <!-- ?v= busts icons cached from other sites previously served on the same host -->
    <link rel="icon" href="/favicon.ico?v=33rd" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=33rd" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png?v=33rd" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=33rd" />
    <meta name="theme-color" content="#1d1c1a" />
    <meta name="geo.region" content="BT-15" />
    <meta name="geo.placename" content="Thimphu, Bhutan" />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt ?? title ?? site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBookBar />
    <WhatsAppFloat />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
